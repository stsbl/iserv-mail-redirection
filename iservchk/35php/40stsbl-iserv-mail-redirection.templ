MkDir 0755 root:root /var/lib/iserv/stsbl-iserv-mail-redirection
MkDir 2770 stsbl-iserv-mail-redirection:stsbl-iserv-mail-redirection /var/lib/iserv/stsbl-iserv-mail-redirection/app
MkDir 2770 stsbl-iserv-mail-redirection:stsbl-iserv-mail-redirection /var/lib/iserv/stsbl-iserv-mail-redirection/pwd
MkDir 0300 stsbl-iserv-mail-redirection:stsbl-iserv-mail-redirection /var/lib/iserv/stsbl-iserv-mail-redirection/sessions

Touch /var/lib/iserv/stsbl-iserv-mail-redirection/pwd/symfony.secret
ChPerm 0440 root:stsbl-iserv-mail-redirection /var/lib/iserv/stsbl-iserv-mail-redirection/pwd/symfony.secret

Test "generate symfony secret"
  [ -s /var/lib/iserv/stsbl-iserv-mail-redirection/pwd/symfony.secret ]
  ---
  pwgen -snc 32 1 | tr -d '\n' >/var/lib/iserv/stsbl-iserv-mail-redirection/pwd/symfony.secret

Check /etc/php/current/fpm/pool-config/iserv-module-stsbl-iserv-mail-redirection.conf
Check /etc/php/$(/usr/lib/iserv/php_version)/fpm/pool.d/iserv-module-stsbl-iserv-mail-redirection.conf

